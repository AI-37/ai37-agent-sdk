  "routingNormalize": [
    {
      "name": "a malformed translation costs only itself, the base and the rest survive",
      "input": {
        "domains": [
          "лифты"
        ],
        "intents": [
          "engineering_calculation"
        ],
        "excludes": [
          "пожарный риск"
        ],
        "i18n": {
          "es": {
            "domains": [
              " ascensores "
            ],
            "excludes": [
              "riesgo de incendio",
              "Riesgo de incendio"
            ]
          },
          "en": {
            "excludes": "not a list"
          },
          "de": {
            "domains": [
              42
            ]
          },
          "123": {
            "domains": [
              "x"
            ]
          },
          "fr": {
            "excludes": [
              "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
            ]
          }
        }
      },
      "expected": {
        "domains": [
          "лифты"
        ],
        "intents": [
          "engineering_calculation"
        ],
        "excludes": [
          "пожарный риск"
        ],
        "i18n": {
          "es": {
            "domains": [
              "ascensores"
            ],
            "excludes": [
              "riesgo de incendio"
            ]
          }
        }
      }
    },
    {
      "name": "no translations — no i18n key",
      "input": {
        "domains": [
          "лифты"
        ],
        "intents": [
          "engineering_calculation"
        ],
        "excludes": [],
        "i18n": {}
      },
      "expected": {
        "domains": [
          "лифты"
        ],
        "intents": [
          "engineering_calculation"
        ],
        "excludes": []
      }
    }
  ],
