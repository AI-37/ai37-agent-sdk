{
  "$comment": "Общие тест-векторы переводов showcase/v1 и routing/v1 (docs#589, срез 5) для TS (packages/ts/test/extension-i18n.test.ts) и Python (packages/python/tests/test_extension_i18n.py): оба SDK обязаны давать ровно expected.",
  "showcaseNormalize": [
    {
      "name": "keys are canonicalised, junk keys and empty entries dropped, norms and gates are not translated",
      "input": {
        "title": "Поиск",
        "summary": "Поиск по документам",
        "capabilities": [
          {
            "id": "find",
            "title": "Найти",
            "summary": "Найдёт пункт"
          }
        ],
        "i18n": {
          "ES-mx": {
            "title": " Título <b> ",
            "norms": [
              {
                "code": "X"
              }
            ],
            "order": 5
          },
          "en": {
            "capabilities": [
              {
                "id": "find",
                "title": "Find",
                "skill": "document-search"
              },
              {
                "id": "missing",
                "title": "Missing"
              },
              {
                "id": "find",
                "title": "Duplicate"
              },
              {
                "title": "No id"
              }
            ]
          },
          "русский": {
            "title": "Не тег"
          },
          "de": {},
          "fr": "строка",
          "pt": {
            "capabilities": [
              {
                "id": "missing",
                "title": "Faltando"
              }
            ]
          },
          "it": {
            "title": "   "
          }
        }
      },
      "expected": {
        "title": "Поиск",
        "summary": "Поиск по документам",
        "capabilities": [
          {
            "id": "find",
            "title": "Найти",
            "summary": "Найдёт пункт"
          }
        ],
        "i18n": {
          "es-MX": {
            "title": "Título b"
          },
          "en": {
            "capabilities": [
              {
                "id": "find",
                "title": "Find"
              }
            ]
          }
        }
      }
    },
    {
      "name": "the first of two keys with the same canonical tag wins",
      "input": {
        "title": "Поиск",
        "summary": "Поиск по документам",
        "i18n": {
          "es": {
            "title": "Uno"
          },
          "ES": {
            "title": "Dos"
          }
        }
      },
      "expected": {
        "title": "Поиск",
        "summary": "Поиск по документам",
        "i18n": {
          "es": {
            "title": "Uno"
          }
        }
      }
    },
    {
      "name": "translated text is clamped like the base",
      "input": {
        "title": "Поиск",
        "summary": "Поиск по документам",
        "i18n": {
          "en": {
            "title": "TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT",
            "examples": [
              "Same",
              "same",
              "  "
            ]
          }
        }
      },
      "expected": {
        "title": "Поиск",
        "summary": "Поиск по документам",
        "i18n": {
          "en": {
            "title": "TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT…",
            "examples": [
              "Same"
            ]
          }
        }
      }
    },
    {
      "name": "i18n that is not an object is omitted",
      "input": {
        "title": "Поиск",
        "summary": "Поиск по документам",
        "i18n": [
          "en"
        ]
      },
      "expected": {
        "title": "Поиск",
        "summary": "Поиск по документам"
      }
    }
  ],
