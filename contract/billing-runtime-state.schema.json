{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai37.ru/contracts/ai37-agent-sdk/billing-runtime-state.schema.json",
  "title": "BillingRuntimeState (v1.2)",
  "description": "Ответ billing-сервиса GET /api/v1/billing/customers/by-billing-org/{billing_org_id}/state. v1.2 добавляет llmKey (агент берёт ключ LLM-шлюза отсюда, не из JWT/тела).",
  "type": "object",
  "required": ["orgId", "billingOrgId", "entitlementStatus", "remainingTotalTokens", "features", "stale"],
  "additionalProperties": true,
  "properties": {
    "orgId": { "type": "string" },
    "billingOrgId": { "type": "string" },
    "licensedExternalSubscriptionId": { "type": ["string", "null"] },
    "meteredExternalSubscriptionId": { "type": ["string", "null"] },
    "currentPlanCode": { "type": ["string", "null"] },
    "currentSubscriptionStatus": { "type": ["string", "null"] },
    "entitlementStatus": {
      "type": "string",
      "description": "active | no_resources | payment_failed | ... Любое значение != active → отказ; no_resources = кончились токены, payment_failed = терминальный провал платежа. Конкретное значение выбирает текст ошибки."
    },
    "remainingTotalTokens": { "type": "number" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "privileges"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] },
          "privileges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "valueType", "config"],
              "properties": {
                "code": { "type": "string" },
                "name": { "type": ["string", "null"] },
                "value": { "type": ["number", "boolean", "string", "null"] },
                "valueType": { "type": "string", "enum": ["integer", "boolean", "string", "select"] },
                "config": {
                  "type": "object",
                  "properties": { "selectOptions": { "type": "array", "items": { "type": "string" } } }
                }
              }
            }
          }
        }
      }
    },
    "llmKey": {
      "type": ["string", "null"],
      "description": "Виртуальный ключ LLM-шлюза (v1.2+). Используется как apiKey к LLM-шлюзу. Секрет — не логировать."
    },
    "trialEndsAt": { "type": ["string", "null"] },
    "snapshotUpdatedAt": { "type": "string" },
    "snapshotVersion": { "type": "number" },
    "stale": { "type": "boolean" },
    "subject": {
      "type": "object",
      "description": "Роль и группы пользователя в организации (AI-37/docs#749). Есть, только если state запрошен с ?subject=<sub>. Ключи в snake_case по плану; SDK принимает и camelCase (userUuid, groupIds).",
      "required": ["user_uuid", "group_ids", "member"],
      "additionalProperties": true,
      "properties": {
        "user_uuid": { "type": "string" },
        "role": { "type": ["string", "null"], "enum": ["OWNER", "EDITOR", "USER", null] },
        "group_ids": { "type": "array", "items": { "type": "string" } },
        "member": { "type": "boolean", "description": "false — sub не активный участник организации; тогда group_ids пуст, role может быть null." }
      }
    }
  }
}
